# ── Supabase (free tier) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Agent-mesh service account (created by scripts/bootstrap.sql). Used for cron, marketplace and signup.
AGENT_BOT_EMAIL=agents@salonmind.app
AGENT_BOT_PASSWORD=change-me
# Shared secret for /api/agents/tick (cron)
CRON_SECRET=change-me

# ── Free LLM providers (any one is enough; tried in this order, rules-engine fallback if none) ──
# https://console.groq.com/keys           (free: Llama 3.3 70B, ~30 req/min)
GROQ_API_KEY=
# https://aistudio.google.com/apikey       (free: Gemini 2.x Flash + text-embedding + vision)
GEMINI_API_KEY=
# https://openrouter.ai/keys               (free ":free" models)
OPENROUTER_API_KEY=

# ── Optional messaging (otherwise messages are logged as "simulated" in the Inbox) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
