# ── Supabase (free tier) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Agent-mesh service account (created by scripts/bootstrap.sql). Used for cron, marketplace and signup.
AGENT_BOT_EMAIL=agents@salonmind.app
AGENT_BOT_PASSWORD=change-me
# Shared secret for /api/agents/tick (cron)
CRON_SECRET=change-me

# ── Optional: Clerk sign-in (free Hobby plan) ──
# https://dashboard.clerk.com → create an application → API keys (Development keys work on *.vercel.app). With both
# set, /login and /signup show Clerk's window (password, Google, Apple, Microsoft) plus a 6-digit email-code option;
# without them the password forms stay.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Free LLM providers (any one is enough; tried in this order, rules-engine fallback if none) ──
# https://console.groq.com/keys           (free: Llama 3.3 70B, ~30 req/min)
GROQ_API_KEY=
# https://aistudio.google.com/apikey       (free: Gemini 2.x Flash + text-embedding + vision)
GEMINI_API_KEY=
# https://openrouter.ai/keys               (free ":free" models)
OPENROUTER_API_KEY=

# https://huggingface.co/settings/tokens   (free: Llama via the router; also Whisper speech-to-text and opus-mt translation)
HF_TOKEN=
# Translation works with no key (MyMemory public API, ~5,000 characters/day per server IP). Optional, not secret:
# a contact e-mail raises that to ~50,000/day.
MYMEMORY_EMAIL=
# Voice: browser speech recognition first; GROQ_API_KEY or HF_TOKEN adds fast server Whisper; without either,
# the browser runs Hugging Face Whisper (onnx-community/whisper-base) itself — free, no key, audio stays on the device.

# ── Optional messaging (otherwise messages are logged as "simulated" in the Inbox) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Public base URL (used in stylist calendar feed links)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# AES-256-GCM field encryption for sensitive notes/resumes (openssl rand -base64 32)
DATA_ENCRYPTION_KEY=
# Optional paid providers (off unless set): OpenAI GPT and Anthropic Claude via LangChain
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
