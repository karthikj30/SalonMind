{
  "name": "salonmind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.mts",
    "worker": "node --env-file=.env.local --conditions=react-server --import tsx services/agent-worker/index.ts",
    "i18n:extract": "node scripts/extract-ui-strings.mjs",
    "icons": "node scripts/make-icons.mjs",
    "app:android": "cd apps/android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../../public/downloads/SalonMind.apk",
    "app:desktop": "cd apps/desktop && npm ci && npm run dist"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.11",
    "@langchain/anthropic": "1.6.5",
    "@langchain/core": "1.4.1",
    "@langchain/google-genai": "2.3.6",
    "@langchain/groq": "1.3.1",
    "@langchain/openai": "1.8.4",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "0.468.0",
    "next": "15.5.29",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2"
  }
}
